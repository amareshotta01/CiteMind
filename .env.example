# Copy this file to .env and fill in your values. Never commit .env to git.

# LLM providers (used in later phases)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# MongoDB — local install: mongodb://localhost:27017
# OR MongoDB Atlas free tier connection string
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=citemind
